# ==============================================================
# BLINK ACADEMY — variáveis de ambiente
# Copie para .env.local (desenvolvimento) e configure também na Vercel.
# NUNCA coloque estas chaves no frontend nem no Git.
# ==============================================================

# URL pública do site (sem barra no final). Ex.: https://academy.blink.com.br
APP_URL=http://localhost:3000

# Postgres do Supabase. Use a "Connection string" do pooler (Transaction, porta 6543).
DATABASE_URL=postgres://postgres:senha@localhost:5432/blink

# Segredos da aplicação (gere com: npm run secrets)
# Chave AES-256 (base64, 32 bytes) para criptografar CPF e segredos TOTP.
DATA_ENCRYPTION_KEY=
# Pepper (base64) para o hash de busca do CPF e dos códigos de verificação.
HASH_PEPPER=
# Segredo (base64) para assinar URLs temporárias de mídia local.
MEDIA_SIGNING_SECRET=
# Segredo usado pela rotina agendada de retenção (Vercel Cron).
CRON_SECRET=

# Armazenamento de vídeos e PDFs: "supabase" em produção, "local" só para desenvolvimento.
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=./storage-local
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=academy-private

# Envio do código de verificação: "console" (desenvolvimento), "resend" (e-mail), "twilio" (SMS)
MESSAGING_DRIVER=console
RESEND_API_KEY=
RESEND_FROM="BLINK Academy <nao-responda@seudominio.com.br>"
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
# Canal preferido quando o motorista tem telefone e e-mail: "sms" ou "email"
OTP_PREFERRED_CHANNEL=sms
